{
  "name": "niaganta-pos",
  "private": true,
  "version": "1.0.1",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && npx electron .\"",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "localforage": "^1.10.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.1.6",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.niaganta.pos",
    "productName": "Niaganta POS",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Zens-dev1",
        "repo": "Niaganta-pos"
      }
    ],
    "files": [
      "dist/**/*",
      "electron.js"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}